# Non-secret publisher configuration. Install as mode 0644 or stricter.
GITHUB_REPOSITORY=owner/ros2-performance-monitoring
GITHUB_WORKFLOW=scheduled-rclcpp-comparison.yml
GITHUB_ARTIFACT_PREFIX=rclcpp-dashboard-
GITHUB_TOKEN_FILE=/etc/ros2-performance-monitoring/github-actions.token
GITHUB_API_URL=https://api.github.com
PRODUCER_PROFILE=/opt/ros2-performance-monitoring/.github/benchmark-profiles/rolling-workflow-smoke-v2.json
DEPLOYMENT_ROOT=/srv/ros2-performance-monitoring/dashboard
HISTORY_LIMIT=10
INACTIVE_RETENTION=20
RESTART_HOOK=/usr/local/libexec/ros2-performance-restart-dashboard
EXPORTER_HEALTH_URL=http://127.0.0.1:9108/healthz
PROMETHEUS_HEALTH_URL=http://127.0.0.1:9090/-/healthy
HEALTH_TIMEOUT=30

# Used only by the example restart hook. This file should define the same
# ROS2_PERFORMANCE_DASHBOARD_DATA_DIR and ROS2_PERFORMANCE_HISTORY_INDEX_PATH
# used to start the long-running dashboard stack.
DASHBOARD_COMPOSE_FILE=/opt/ros2-performance-monitoring/compose.yml
DASHBOARD_ENV_FILE=/etc/ros2-performance-monitoring/dashboard.env
